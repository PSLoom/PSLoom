<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Versioning. A project opts in by setting $(VersionTagPrefix) (e.g. "psloom", "reed"); its version then comes from the
    nearest tag matching "<prefix>/v<major>.<minor>.<patch>[-<prerelease>]". Without a matching tag (or without any commit)
    the version falls back to 0.0.0.
  -->
  <Target Name="GetVersionFromGit"
          BeforeTargets="BeforeBuild;GenerateNuspec;GeneratePowerShellManifest"
          Condition="'$(VersionTagPrefix)' != ''">
    <Exec Command="git describe --tags --long --always --match &quot;$(VersionTagPrefix)/v*&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          EchoOff="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDescribeOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_GitDescribeExitCode" />
    </Exec>

    <PropertyGroup>
      <_GitDescribeOutput Condition="'$(_GitDescribeExitCode)' != '0'"></_GitDescribeOutput>
      <_GitVersionRegex>^$(VersionTagPrefix)/v(\d+\.\d+\.\d+)(?:-([0-9A-Za-z.]+))?-(\d+)-g([0-9a-f]+)$</_GitVersionRegex>
      <_GitVersionMatches>$([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitDescribeOutput)', '$(_GitVersionRegex)'))</_GitVersionMatches>
      <_GitDescribeOutput Condition="'$(_GitVersionMatches)' != 'True'">$(VersionTagPrefix)/v0.0.0-0-g0000000</_GitDescribeOutput>

      <_GitCoreVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_GitDescribeOutput)', '$(_GitVersionRegex)').Groups[1].Value)</_GitCoreVersion>
      <_GitPrerelease>$([System.Text.RegularExpressions.Regex]::Match('$(_GitDescribeOutput)', '$(_GitVersionRegex)').Groups[2].Value)</_GitPrerelease>
      <_GitAdditionalCommits>$([System.Text.RegularExpressions.Regex]::Match('$(_GitDescribeOutput)', '$(_GitVersionRegex)').Groups[3].Value)</_GitAdditionalCommits>
      <_GitCommitSha>$([System.Text.RegularExpressions.Regex]::Match('$(_GitDescribeOutput)', '$(_GitVersionRegex)').Groups[4].Value)</_GitCommitSha>

      <_GitSemanticVersion>$(_GitCoreVersion)</_GitSemanticVersion>
      <_GitSemanticVersion Condition="'$(_GitPrerelease)' != ''">$(_GitCoreVersion)-$(_GitPrerelease)</_GitSemanticVersion>

      <Version>$(_GitCoreVersion)</Version>
      <FileVersion>$(_GitCoreVersion)</FileVersion>
      <PackageVersion>$(_GitSemanticVersion)</PackageVersion>
      <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
      <InformationalVersion>$(_GitSemanticVersion)+$(_GitAdditionalCommits).$(_GitCommitSha)</InformationalVersion>

      <!--
        AssemblyVersion normally tracks the tag. A contract assembly sets $(ContractAssemblyVersion) in its project file
        (src/Warp/Warp.csproj does) so runtime binding stays stable across kernel releases.
      -->
      <AssemblyVersion Condition="'$(ContractAssemblyVersion)' != ''">$(ContractAssemblyVersion)</AssemblyVersion>
      <AssemblyVersion Condition="'$(ContractAssemblyVersion)' == ''">$(_GitCoreVersion)</AssemblyVersion>
    </PropertyGroup>
  </Target>

  <!--
    PowerShell module layout. A project opts in by setting $(PowerShellManifest) to its .psd1 file. The manifest's
    $version$ token is replaced at build time, and PublishModule copies the build output to
    artifacts/modules/<ModuleName>/<version>/, the layout Import-Module and Publish-PSResource expect.
  -->
  <PropertyGroup Condition="'$(PowerShellManifest)' != ''">
    <ModuleName Condition="'$(ModuleName)' == ''">$(AssemblyName)</ModuleName>
  </PropertyGroup>

  <Target Name="GeneratePowerShellManifest" BeforeTargets="Build;Pack" Condition="'$(PowerShellManifest)' != ''">
    <PropertyGroup>
      <_ManifestOut>$(IntermediateOutputPath)$([System.IO.Path]::GetFileName('$(PowerShellManifest)'))</_ManifestOut>
      <_ManifestVersion Condition="'$(Version)' != ''">$(Version)</_ManifestVersion>
      <_ManifestVersion Condition="'$(Version)' == ''">0.0.0</_ManifestVersion>
      <_ManifestContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\$(PowerShellManifest)'))</_ManifestContent>
      <_ManifestContentReplaced>$(_ManifestContent.Replace('$version$', '$(_ManifestVersion)'))</_ManifestContentReplaced>
    </PropertyGroup>

    <WriteLinesToFile File="$(_ManifestOut)" Lines="$(_ManifestContentReplaced)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <MakeDir Directories="$(OutDir)" Condition="'$(OutDir)' != '' and !Exists('$(OutDir)')" />
    <Copy SourceFiles="$(_ManifestOut)" DestinationFolder="$(OutDir)" Condition="'$(OutDir)' != ''" SkipUnchangedFiles="true" />

    <ItemGroup>
      <None Include="$(_ManifestOut)" Pack="true" PackagePath="\" Visible="false" />
      <FileWrites Include="$(_ManifestOut)" />
    </ItemGroup>
  </Target>

  <Target Name="PublishModule"
          AfterTargets="Build"
          DependsOnTargets="Build"
          Condition="'$(PowerShellManifest)' != '' and '$(PublishModuleOnBuild)' != 'false'">
    <PropertyGroup>
      <_ModuleRoot>$(ArtifactsModulesDirectory)$(ModuleName)\</_ModuleRoot>
      <_ModuleDestination>$(_ModuleRoot)$(Version)\</_ModuleDestination>
    </PropertyGroup>

    <ItemGroup>
      <_ModuleFiles Include="$(OutDir)**\*" />
    </ItemGroup>

    <RemoveDir Directories="$(_ModuleRoot)" />
    <Copy SourceFiles="@(_ModuleFiles)" DestinationFiles="@(_ModuleFiles->'$(_ModuleDestination)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="$(ModuleName) -&gt; $(_ModuleDestination)" />
  </Target>

  <Target Name="CleanupAll">
    <Exec Command="dotnet jb cleanupcode &quot;$(ProjectPath)&quot; --profile=&quot;Built-in: Full Cleanup&quot;" />
  </Target>

  <Target Name="CleanupModified">
    <Exec Command="git status --porcelain=v1 &gt; &quot;$(IntermediateOutputPath)modified.txt&quot;" />

    <ReadLinesFromFile File="$(IntermediateOutputPath)modified.txt">
      <Output TaskParameter="Lines" ItemName="GitStatus" />
    </ReadLinesFromFile>

    <ItemGroup>
      <ModifiedFiles Include="@(GitStatus)">
        <File>$([System.String]::Copy('%(Identity)').Substring(3).Trim())</File>
      </ModifiedFiles>

      <CleanupFiles Include="@(ModifiedFiles->'%(File)')"
                    Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ModifiedFiles.File)', '\.(cs|csproj)$'))" />
    </ItemGroup>

    <PropertyGroup>
      <IncludeFiles>@(CleanupFiles,';')</IncludeFiles>
    </PropertyGroup>

    <Exec Condition="'$(IncludeFiles)' != ''"
          Command="dotnet jb cleanupcode &quot;$(SolutionPath)&quot; --profile=&quot;Built-in: Full Cleanup&quot; --include=&quot;$(IncludeFiles)&quot;" />

    <Message Condition="'$(IncludeFiles)' == ''" Importance="high" Text="No modified files to clean up." />
  </Target>
</Project>
