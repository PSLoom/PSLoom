<Project>
  <PropertyGroup>
    <ModuleName Condition="'$(ModuleName)' == ''">$(AssemblyName)</ModuleName>
    <ModuleManifestTemplate Condition="'$(ModuleManifestTemplate)' == ''">$(MSBuildProjectDirectory)/$(ModuleName).psd1</ModuleManifestTemplate>
    <ModuleOutputDir>$(ArtifactsModulesDir)$(ModuleName)/</ModuleOutputDir>
    <_ManifestToolProject>$(PSLoomEngDir)tools/PSLoom.ManifestTool/PSLoom.ManifestTool.csproj</_ManifestToolProject>
  </PropertyGroup>

  <!--
    Copies the module assembly to artifacts/modules/<Module>/ and writes its manifest next to it. The cmdlet
    list and the version come from the build, so the manifest cannot drift from the code.
  -->
  <Target Name="AssembleModule" AfterTargets="Build">
    <Error Condition="!Exists('$(ModuleManifestTemplate)')"
           Text="The module manifest template '$(ModuleManifestTemplate)' does not exist." />

    <MSBuild Projects="$(_ManifestToolProject)" Targets="Build">
      <Output TaskParameter="TargetOutputs" ItemName="_ManifestToolAssembly" />
    </MSBuild>

    <MakeDir Directories="$(ModuleOutputDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModuleOutputDir)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <_RequiredModuleArgument Include="@(RequiredPSModule->'--required-module &quot;%(Identity)=%(MinimumVersion)&quot;')" />
    </ItemGroup>

    <Exec Command="dotnet &quot;@(_ManifestToolAssembly)&quot; --assembly &quot;$(TargetPath)&quot; --template &quot;$(ModuleManifestTemplate)&quot; --output &quot;$(ModuleOutputDir)$(ModuleName).psd1&quot; --version &quot;$(Version)&quot; @(_RequiredModuleArgument, ' ')" />

    <!--
      A stray copy of a required module does not load twice: whichever copy loads first wins, so the required
      module could end up running from this folder, with a stale assembly.
    -->
    <Error Condition="Exists('$(ModuleOutputDir)%(RequiredPSModule.Identity).dll')"
           Text="The module folder '$(ModuleOutputDir)' holds a copy of %(RequiredPSModule.Identity).dll. A module never ships the assembly of a module it requires." />
  </Target>
</Project>
