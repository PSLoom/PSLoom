<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <VersionTagPrefix>psloom</VersionTagPrefix>
    <PowerShellManifest>PSLoom.psd1</PowerShellManifest>
  </PropertyGroup>

  <PropertyGroup>
    <Description>The shell-ergonomics layer PowerShell never shipped with</Description>
    <PackageId>PSLoom</PackageId>
    <PackageTags>powershell; pwsh; psloom; loom; shell; zsh; fish</PackageTags>
    <PackageReadmeFile Condition="Exists('README.md')">README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
    <None Include="$(RepositoryRoot)LICENSE.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.Management.Automation" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management.Automation" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PSLoom.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <!-- The kernel module ships Warp.dll; harnesses bind to this copy. -->
    <ProjectReference Include="..\Warp\Warp.csproj" />
  </ItemGroup>
</Project>
