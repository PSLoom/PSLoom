<Project>
  <!-- Resolve before the SDK computes assembly attributes or queries a project reference's package version. -->
  <Target Name="GetVersionFromGit"
          BeforeTargets="PrepareForBuild;GetAssemblyVersion;CoreGenerateAssemblyInfo;_GetProjectVersion;GenerateNuspec;GeneratePowerShellManifest"
          Condition="'$(VersionTagPrefix)' != '' or '$(VersionOverride)' != ''">
    <Error Condition="'$(VersionTagPrefix)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(VersionTagPrefix)', '^[A-Za-z0-9_.-]+$'))"
           Text="VersionTagPrefix must contain only letters, digits, dots, underscores or hyphens." />
    <Exec Condition="'$(VersionOverride)' == ''"
          Command="git describe --tags --long --match &quot;$(VersionTagPrefix)/v*&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDescribeOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_GitDescribeExitCode" />
    </Exec>
    <PropertyGroup>
      <_SemanticVersionPattern>(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?</_SemanticVersionPattern>
      <_GitVersionRegex>^$([System.Text.RegularExpressions.Regex]::Escape('$(VersionTagPrefix)'))/v(?&lt;version&gt;$(_SemanticVersionPattern))-(?&lt;distance&gt;[0-9]+)-g(?&lt;sha&gt;[0-9a-f]+)$</_GitVersionRegex>
      <_ResolvedVersion>0.0.0</_ResolvedVersion>
      <_ResolvedVersion Condition="'$(_GitDescribeExitCode)' == '0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitDescribeOutput)', '$(_GitVersionRegex)'))">$([System.Text.RegularExpressions.Regex]::Match('$(_GitDescribeOutput)', '$(_GitVersionRegex)').Groups['version'].Value)</_ResolvedVersion>
      <_ResolvedVersion Condition="'$(VersionOverride)' != ''">$(VersionOverride)</_ResolvedVersion>
    </PropertyGroup>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_ResolvedVersion)', '^$(_SemanticVersionPattern)$'))"
           Text="Invalid semantic version '$(_ResolvedVersion)'. Expected major.minor.patch[-prerelease][+metadata]." />
    <PropertyGroup>
      <Version>$([System.Text.RegularExpressions.Regex]::Match('$(_ResolvedVersion)', '^[0-9]+\.[0-9]+\.[0-9]+').Value)</Version>
      <PackageVersion>$(_ResolvedVersion)</PackageVersion>
      <FileVersion>$(Version)</FileVersion>
      <AssemblyVersion Condition="'$(ContractAssemblyVersion)' == ''">$(Version)</AssemblyVersion>
      <AssemblyVersion Condition="'$(ContractAssemblyVersion)' != ''">$(ContractAssemblyVersion)</AssemblyVersion>
      <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
      <InformationalVersion>$(_ResolvedVersion)</InformationalVersion>
      <_VersionMetadataSeparator Condition="$(_ResolvedVersion.Contains('+'))">.</_VersionMetadataSeparator>
      <_VersionMetadataSeparator Condition="!$(_ResolvedVersion.Contains('+'))">+</_VersionMetadataSeparator>
      <InformationalVersion Condition="'$(VersionOverride)' == '' and '$(_GitDescribeExitCode)' == '0' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitDescribeOutput)', '$(_GitVersionRegex)'))">$(_ResolvedVersion)$(_VersionMetadataSeparator)$([System.Text.RegularExpressions.Regex]::Match('$(_GitDescribeOutput)', '$(_GitVersionRegex)').Groups['distance'].Value).$([System.Text.RegularExpressions.Regex]::Match('$(_GitDescribeOutput)', '$(_GitVersionRegex)').Groups['sha'].Value)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <!--
    PowerShell module layout. A project opts in by setting $(PowerShellManifest) to its .psd1 file. The manifest's
    $version$ token is replaced at build time, and PublishModule copies the build output to
    artifacts/modules/<ModuleName>/<version>/, the layout Import-Module and Publish-PSResource expect.
  -->
  <PropertyGroup Condition="'$(PowerShellManifest)' != ''">
    <ModuleName Condition="'$(ModuleName)' == ''">$(AssemblyName)</ModuleName>
  </PropertyGroup>

  <Target Name="GeneratePowerShellManifest" BeforeTargets="Build;Pack" DependsOnTargets="GetVersionFromGit" Condition="'$(PowerShellManifest)' != ''">
    <PropertyGroup>
      <_ManifestOut>$(IntermediateOutputPath)$([System.IO.Path]::GetFileName('$(PowerShellManifest)'))</_ManifestOut>
      <_ManifestVersion Condition="'$(Version)' != ''">$(Version)</_ManifestVersion>
      <_ManifestVersion Condition="'$(Version)' == ''">0.0.0</_ManifestVersion>
      <_ManifestContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/$(PowerShellManifest)'))</_ManifestContent>
      <_ManifestContentReplaced>$(_ManifestContent.Replace('$version$', '$(_ManifestVersion)'))</_ManifestContentReplaced>
    </PropertyGroup>

    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(_ManifestOut)" Lines="$(_ManifestContentReplaced)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <MakeDir Directories="$(OutDir)" Condition="'$(OutDir)' != '' and !Exists('$(OutDir)')" />
    <Copy SourceFiles="$(_ManifestOut)" DestinationFolder="$(OutDir)" Condition="'$(OutDir)' != ''" SkipUnchangedFiles="true" />

    <ItemGroup>
      <None Include="$(_ManifestOut)" Pack="true" PackagePath="\" Visible="false" />
      <FileWrites Include="$(_ManifestOut)" />
    </ItemGroup>
  </Target>

  <Target Name="PublishModule"
          AfterTargets="Build"
          DependsOnTargets="GeneratePowerShellManifest"
          Condition="'$(PowerShellManifest)' != '' and '$(PublishModuleOnBuild)' != 'false'">
    <PropertyGroup>
      <_ModuleRoot>$(ArtifactsModulesDirectory)$(ModuleName)\</_ModuleRoot>
      <_ModuleDestination>$(_ModuleRoot)$(Version)\</_ModuleDestination>
    </PropertyGroup>

    <ItemGroup>
      <_ModuleFiles Include="$(OutDir)**\*" />
    </ItemGroup>

    <RemoveDir Directories="$(_ModuleRoot)" />
    <Copy SourceFiles="@(_ModuleFiles)" DestinationFiles="@(_ModuleFiles->'$(_ModuleDestination)%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="$(ModuleName) -&gt; $(_ModuleDestination)" />
  </Target>

  <PropertyGroup Condition="'$(PowerShellManifest)' != ''">
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackModuleLayout</TargetsForTfmSpecificContentInPackage>
    <!-- module/ assemblies are intentionally runtime content; lib/ separately supplies compile references. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>

  <Target Name="PackModuleLayout" DependsOnTargets="GeneratePowerShellManifest" Condition="'$(PowerShellManifest)' != ''">
    <Error Condition="!Exists('$(TargetPath)')" Text="Build $(MSBuildProjectName) before packing its module layout." />
    <ItemGroup>
      <_PackedModuleFile Include="$(OutDir)**/*" Exclude="$(OutDir)**/*.pdb" />
      <TfmSpecificPackageFile Include="@(_PackedModuleFile)">
        <PackagePath>module/%(_PackedModuleFile.RecursiveDir)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <UsingTask TaskName="PSLoomRestoreModule" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
      <PackageVersion ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Threading" />
      <Code Type="Fragment" Language="cs" Source="$(MSBuildThisFileDirectory)RestoreModule.cs" />
    </Task>
  </UsingTask>

  <Target Name="RestoreKernelModule" BeforeTargets="PrepareForBuild" Condition="'$(RequiresKernelModule)' == 'true'">
    <Error Condition="'$(PkgPSLoom)' == ''" Text="RequiresKernelModule needs PackageReference PSLoom with GeneratePathProperty=true." />
    <Error Condition="'$(PSLoomVersion)' == ''" Text="RequiresKernelModule needs PSLoomVersion." />
    <Error Condition="!Exists('$(PkgPSLoom)/module/PSLoom.psd1')" Text="The PSLoom package has no module/PSLoom.psd1." />
    <PSLoomRestoreModule Source="$(PkgPSLoom)/module" Destination="$([MSBuild]::NormalizePath('$(ArtifactsModulesDirectory)', 'PSLoom'))" PackageVersion="$(PSLoomVersion)" />
  </Target>
</Project>
